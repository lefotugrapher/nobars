{
  "manifest_version": 3,
  "name": "NoBars — Fill Video to Screen",
  "short_name": "NoBars",
  "version": "1.0.0",
  "description": "Removes black bars from videos on any screen shape. Fill (crop) or Stretch, in fullscreen or everywhere.",
  "permissions": ["storage", "activeTab"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NoBars",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "commands": {
    "cycle-mode": {
      "suggested_key": { "default": "Alt+Shift+F", "mac": "Alt+Shift+F" },
      "description": "Cycle mode: Fill → Stretch → Off"
    }
  }
}
